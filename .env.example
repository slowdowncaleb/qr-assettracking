# ArcGIS Authentication (App ID / Secret)
ARCGIS_CLIENT_ID="YOUR_ARCGIS_CLIENT_ID"
ARCGIS_CLIENT_SECRET="YOUR_ARCGIS_CLIENT_SECRET"

# ArcGIS Feature Layer URLs
FEATURE_LAYER_URL="https://services.arcgis.com/your_org/arcgis/rest/services/QR_Asset_Tracking/FeatureServer/0"
FEATURE_LAYER_URL_5MIN="https://services.arcgis.com/your_org/arcgis/rest/services/QR_Asset_Tracking/FeatureServer/1"
FEATURE_LAYER_URL_DAILY="https://services.arcgis.com/your_org/arcgis/rest/services/QR_Asset_Tracking/FeatureServer/2"

# Redirect / Target Web Map URL
TARGET_WEB_MAP_URL="https://experience.arcgis.com/experience/your_app_id"
